// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?   @db.Text
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model MerchantSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  badgesEnabled     Boolean  @default(true)
  badgeStyle        String   @default("classic") // classic | minimal | bold
  showOnProduct     Boolean  @default(true)
  showOnCart        Boolean  @default(true)
  guaranteeTabPosition String @default("right") // right | left | bottom | top
  protectionPayer   String   @default("customer") // customer | merchant
  enabledClaimTypes String   @default("lost,damaged,stolen,shortage,concealed,wrong_item") // comma-separated
  claimWindows      String   @db.Text // JSON: { [issueType]: { minDays, maxDays } } since fulfillment
  protectionFeeType         String @default("flat") // flat | percentage
  protectionFlatFeeCents    Int    @default(299)
  protectionPercentBasisPoints Int @default(200) // 200 = 2.00% of order value
  protectionMinFeeCents     Int    @default(99)
  protectionMaxFeeCents     Int    @default(999)
  // Coverage eligibility — deliberately separate from the pricing fields above.
  // The protection *price* is what the shopper pays; this is the ceiling on the
  // merchandise value that may receive protection at all. Per-item unit value,
  // excluding shipping and tax. NULL means the merchant has set no ceiling, so
  // no threshold is applied — there is no built-in monetary default.
  maxEligibleItemValueCents Int?
  protectionEnabled         Boolean @default(false)
  plan                      String  @default("usage") // usage | unlimited
  currency                  String  @default("USD")
  storefrontFallbackLanguage String @default("en")
  storefrontLanguages        String @default("en,fr")
  protectionProductId       String?
  protectionVariantId       String?
  planTier                  String  @default("unknown") // unknown | standard | plus | dev
  cartTransformId           String? // gid of the active Cart Transform (percentage fee), if any
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProtectedOrder {
  id                   String   @id @default(cuid())
  shop                 String
  shopifyOrderId       String
  shopifyOrderName     String?
  // What the shopper paid for protection. NOT the coverage amount.
  protectionPriceCents Int
  // Sum of eligible item line values at the time protection was recorded,
  // excluding shipping, tax and the protection line itself. This is the
  // merchandise value coverage is assessed against.
  coveredMerchandiseCents Int   @default(0)
  // The merchant's eligibility ceiling as it stood when this order was
  // protected, so later settings changes can't retroactively alter a claim.
  maxEligibleItemValueCents Int?
  currency             String
  customerSelected     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  usageEvents           UsageEvent[]
  items                 ProtectedOrderItem[]

  @@unique([shop, shopifyOrderId])
  @@index([shop, createdAt])
}

// Item-level coverage. One row per merchandise line on a protected order, so a
// claim can name the specific item, its quantity and its unit value rather than
// asserting a whole-order loss.
model ProtectedOrderItem {
  id               String   @id @default(cuid())
  shop             String
  protectedOrderId String
  lineItemId       String // Shopify line item id from the order payload
  title            String
  variantId        String?
  sku              String?
  quantity         Int
  // Per-unit merchandise price, excluding shipping and tax.
  unitPriceCents   Int
  // Evaluated once, at protection time, against the merchant's ceiling.
  eligible         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  protectedOrder   ProtectedOrder @relation(fields: [protectedOrderId], references: [id], onDelete: Cascade)

  @@unique([protectedOrderId, lineItemId])
  @@index([shop])
}

model UsageEvent {
  id               String         @id @default(cuid())
  shop             String
  protectedOrderId String
  eventType         String         @default("protected_order")
  amountCents       Int            @default(60)
  status            String         @default("pending") // pending | billed | waived | failed
  shopifyUsageId    String?
  createdAt         DateTime       @default(now())
  protectedOrder    ProtectedOrder @relation(fields: [protectedOrderId], references: [id], onDelete: Cascade)

  @@unique([protectedOrderId, eventType])
  @@index([shop, status, createdAt])
}

model ProtectionClaim {
  id                String   @id @default(cuid())
  shop              String
  orderNumber       String
  confirmationCode  String?
  fullName          String
  email             String
  issueType         String // lost | damaged | stolen | shortage | concealed | wrong_item
  details           String?
  status            String   @default("submitted") // submitted | reviewing | resolved | denied
  shopifyOrderId    String? // Admin GraphQL GID, captured once the order is verified
  shopifyOrderName  String? // canonical order name from Shopify, e.g. "#1234"
  orderRiskLevel    String? // LOW | MEDIUM | HIGH | null if lookup failed/unavailable
  evidenceUrl       String? // Shopify-hosted image URL, required for damaged/concealed
  resolvedAt        DateTime? // set the first time status becomes resolved or denied

  // --- Item-level coverage ---
  // Links the claim to the protection that authorises it. Set at submission and
  // required by the claim endpoint, so a claim cannot exist without protection.
  protectedOrderId  String?
  protectedItemId   String? // ProtectedOrderItem.id — which item is claimed
  claimedQuantity   Int? // units affected, bounded by the item's ordered quantity
  itemValueCents    Int? // unit value captured at submission
  // claimedQuantity × itemValueCents, less anything already settled on this
  // item. The ceiling on what the merchant could approve — never a payout.
  eligibleLossCents Int?
  // What the merchant actually approved. Entered by the merchant on approval;
  // null on denied or still-open claims. Kourify never sets this on its own.
  settlementCents   Int?
  decisionNote      String? @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
  @@index([shop, email])
  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([protectedOrderId])
  @@index([protectedItemId])
}

// NEW: Order caching for production scaling (see CODE_REVIEW.md)
model Order {
  id              String   @id // Shopify GraphQL ID
  shop            String
  name            String   // Order #1001
  email           String
  customerName    String?
  status          String   // fulfilled, pending, canceled, refunded
  riskLevel       String?  // LOW, MEDIUM, HIGH
  shippedAt       DateTime?
  deliveredAt     DateTime?
  totalPrice      String?  // For future analytics
  // When the customer actually placed the order, from Shopify. Distinct from
  // createdAt, which is when we first cached the row — a backfill writes
  // thousands of rows "now", so createdAt can't order a merchant's orders.
  // Nullable because rows cached before this field existed never captured it.
  placedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
  @@index([shop, email])
  @@index([shop, status])
  @@index([shop, placedAt])
}

// Tracks a background order backfill driven by Shopify's Bulk Operations API
// (see app/lib/order-bulk-sync.server.ts). A store with thousands of orders
// can't be paginated inline in a request — Shopify builds the export
// server-side and notifies us via the bulk_operations/finish webhook, which
// updates this row as the job progresses.
model SyncJob {
  id              String    @id @default(cuid())
  shop            String
  type            String    @default("order_backfill")
  status          String    @default("queued") // queued | running | completed | failed
  bulkOperationId String? // Shopify gid://shopify/BulkOperation/...
  objectCount     Int? // orders ingested once the job completes
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shop, createdAt])
  @@index([bulkOperationId])
}

// NEW: Audit log for compliance (see CODE_REVIEW.md)
model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  action    String   // claim_status_updated, settings_changed, etc
  userId    String?  // Merchant user ID
  resource  String   // claim:123, settings:shop
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
  @@index([resource])
}

// NEW: Merchant consent tracking (see CODE_REVIEW.md)
model MerchantConsent {
  id              String   @id @default(cuid())
  shop            String   @unique
  acceptedTerms   Boolean  @default(false)
  acceptedAt      DateTime?
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model ProtectionOffer {
  id                     String   @id @default(cuid())
  shop                   String
  originalOrderId        String
  originalOrderName      String
  customerEmail          String
  tokenHash              String   @unique
  status                 String   @default("offer_sent")
  protectionPriceCents   Int
  currency               String
  protectionPurchaseId   String?
  expiresAt              DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([shop, status, createdAt])
  @@index([shop, originalOrderId])
}

model StorefrontTranslation {
  id        String   @id @default(cuid())
  shop      String
  locale    String // "en", "fr", "ar", "hi"
  label     String // switcher display name, e.g. "العربية"
  direction String   @default("ltr") // "ltr" | "rtl"
  enabled   Boolean  @default(true)
  strings   String   @db.Text // JSON: { "<key>": "<value>" }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, locale])
  @@index([shop])
}
