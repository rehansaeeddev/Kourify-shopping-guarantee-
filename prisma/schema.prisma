// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model MerchantSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  badgesEnabled     Boolean  @default(true)
  badgeStyle        String   @default("classic") // classic | minimal | bold
  showOnProduct     Boolean  @default(true)
  showOnCart        Boolean  @default(true)
  protectionPayer   String   @default("customer") // customer | merchant
  enabledClaimTypes String   @default("lost,damaged,stolen,shortage,concealed,wrong_item") // comma-separated
  claimWindows      String   @db.Text // JSON: { [issueType]: { minDays, maxDays } } since fulfillment
  protectionFeeType         String @default("flat") // flat | percentage
  protectionFlatFeeCents    Int    @default(299)
  protectionPercentBasisPoints Int @default(200) // 200 = 2.00% of order value
  protectionMinFeeCents     Int    @default(99)
  protectionMaxFeeCents     Int    @default(999)
  protectionEnabled         Boolean @default(false)
  plan                      String  @default("usage") // usage | unlimited
  currency                  String  @default("USD")
  protectionProductId       String?
  protectionVariantId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProtectedOrder {
  id                   String   @id @default(cuid())
  shop                 String
  shopifyOrderId       String
  shopifyOrderName     String?
  protectionPriceCents Int
  currency             String
  customerSelected     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  usageEvents           UsageEvent[]

  @@unique([shop, shopifyOrderId])
  @@index([shop, createdAt])
}

model UsageEvent {
  id               String         @id @default(cuid())
  shop             String
  protectedOrderId String
  eventType         String         @default("protected_order")
  amountCents       Int            @default(60)
  status            String         @default("pending") // pending | billed | waived | failed
  shopifyUsageId    String?
  createdAt         DateTime       @default(now())
  protectedOrder    ProtectedOrder @relation(fields: [protectedOrderId], references: [id], onDelete: Cascade)

  @@unique([protectedOrderId, eventType])
  @@index([shop, status, createdAt])
}

model ProtectionClaim {
  id                String   @id @default(cuid())
  shop              String
  orderNumber       String
  confirmationCode  String?
  fullName          String
  email             String
  issueType         String // lost | damaged | stolen | shortage | concealed | wrong_item
  details           String?
  status            String   @default("submitted") // submitted | reviewing | resolved | denied
  shopifyOrderId    String? // Admin GraphQL GID, captured once the order is verified
  shopifyOrderName  String? // canonical order name from Shopify, e.g. "#1234"
  orderRiskLevel    String? // LOW | MEDIUM | HIGH | null if lookup failed/unavailable
  evidenceUrl       String? // Shopify-hosted image URL, required for damaged/concealed
  resolvedAt        DateTime? // set the first time status becomes resolved or denied
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
  @@index([shop, email])
  @@index([shop, status])
  @@index([shop, createdAt])
}

// NEW: Order caching for production scaling (see CODE_REVIEW.md)
model Order {
  id              String   @id // Shopify GraphQL ID
  shop            String
  name            String   // Order #1001
  email           String
  status          String   // fulfilled, pending, canceled, refunded
  riskLevel       String?  // LOW, MEDIUM, HIGH
  shippedAt       DateTime?
  totalPrice      String?  // For future analytics
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
  @@index([shop, email])
  @@index([shop, status])
}

// NEW: Audit log for compliance (see CODE_REVIEW.md)
model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  action    String   // claim_status_updated, settings_changed, etc
  userId    String?  // Merchant user ID
  resource  String   // claim:123, settings:shop
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
  @@index([resource])
}

// NEW: Merchant consent tracking (see CODE_REVIEW.md)
model MerchantConsent {
  id              String   @id @default(cuid())
  shop            String   @unique
  acceptedTerms   Boolean  @default(false)
  acceptedAt      DateTime?
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}
