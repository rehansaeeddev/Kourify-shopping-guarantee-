# ---------------------------------------------------------------------------
# Frontend only.
#
# This repo builds the embedded admin and nothing else. Everything secret —
# the database, the Shopify client secret, SMTP credentials — belongs to the
# Laravel backend (kourify-guarantee-backend/.env) and must never be set here:
# anything a Vite build can read can end up in a bundle the browser downloads,
# and VITE_-prefixed variables are shipped to the browser by design.
# ---------------------------------------------------------------------------

# The app's client id. Public by design: it is in shopify.app.toml, and every
# embedded app hands it to the browser so App Bridge can mint session tokens.
# The client SECRET is not this, and does not belong in this file.
VITE_SHOPIFY_API_KEY=

# Set by `shopify app dev` (the tunnel). Only used to allow that host through
# Vite and to configure HMR.
SHOPIFY_APP_URL=

# Where the Laravel backend listens in development. The dev server forwards
# /api, /webhooks and /proxy there; in production Laravel serves the built SPA
# itself, so all three are same-origin and nothing is proxied.
KOURIFY_BACKEND_URL=http://127.0.0.1:8000

# Dev server ports. PORT is the dev server itself; FRONTEND_PORT is the HMR
# socket when running behind a tunnel.
# PORT=3000
# FRONTEND_PORT=8002
