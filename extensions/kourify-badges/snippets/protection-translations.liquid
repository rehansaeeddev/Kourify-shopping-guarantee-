{% doc %}
Provides localized strings and the active storefront locale to the protection JavaScript.
{% enddoc %}

{%- liquid
    # The merchant's name, logo and colour, read straight from the app-data
    # metafields the admin publishes.
    #
    # Deliberately not a shared snippet, though the same lines sit in the
    # other file too: Shopify wraps every app snippet's output in "BEGIN app
    # snippet" comments, so capturing a render put that comment into the
    # tab's own text. Keep the two copies in step.
    #
    # Interpolated rather than concatenated -- English puts the name first,
    # French and Arabic second -- and a shop that has set nothing falls
    # through to the wording and the colours this app has always used.

    assign kourify_brand = app.metafields.kourify.brand_name.value | default: '' | strip
    assign kourify_brand_logo = app.metafields.kourify.brand_logo.value | default: '' | strip
    assign kourify_brand_color = app.metafields.kourify.brand_color.value | default: '' | strip

    if kourify_brand == blank
      assign kourify_brand_name = 'Kourify'
      assign kourify_guarantee = 'protection.guarantee' | t
      assign kourify_modal_title = 'protection.modal_title' | t
      assign kourify_managed = 'protection.managed' | t
      assign kourify_terms = 'protection.modal_terms' | t
    else
      assign kourify_brand_name = kourify_brand
      assign kourify_guarantee = 'protection.guarantee_branded' | t: name: kourify_brand
      assign kourify_modal_title = 'protection.modal_title_branded' | t: name: kourify_brand
      assign kourify_managed = 'protection.managed_branded' | t: name: kourify_brand
      # Without the shop's name the sentence ends ", not the store", which is
      # the whole point of it -- Kourify is not the merchant. Under the
      # merchant's own name that clause contradicts itself, so the branded
      # wording drops it and keeps what still holds: protection is optional,
      # and this is who handles it.
      assign kourify_terms = 'protection.modal_terms_branded' | t: name: kourify_brand
    endif

    # Built by Liquid's own colour filters rather than printed as typed. The
    # value lands in a stylesheet, where escaping does nothing: a colour that
    # closed its own rule could hide the terms or cover a button. So the page
    # carries a value Liquid built, not the one the merchant typed.
    #
    # `append` first because the filters take a string, and a typed metafield
    # hands back an object. Piped in as-is they return nothing -- and nothing
    # is worse here than wrong: a custom property set to an empty value makes
    # every declaration using it invalid, so the tab loses its background and
    # goes white-on-white rather than falling back to its own colours.
    #
    # Which is why every derived value is checked below. If any one of them
    # comes back empty the whole block is skipped, and the shop simply renders
    # in the colours this app ships with.
    assign kourify_color = kourify_brand_color | append: ''
    assign k_rgb = kourify_color | color_to_rgb
    assign k_r = kourify_color | color_extract: 'red'
    assign k_g = kourify_color | color_extract: 'green'
    assign k_b = kourify_color | color_extract: 'blue'
    assign k_dark = kourify_color | color_darken: 10
    assign k_tint = kourify_color | color_lighten: 42
    assign k_tint_strong = kourify_color | color_lighten: 32
    assign k_wash = kourify_color | color_lighten: 46
    assign k_tab_start = kourify_color | color_darken: 8
    assign k_tab_end = kourify_color | color_darken: 20
    assign k_tab_icon = kourify_color | color_lighten: 28

    # The product card, the cart card and the compact badge read this second
    # family, not --kourify-brand. It is a theme block setting, which is why
    # a merchant with a pink shop still had a green card next to a pink tab.
    # The darken is heavier than the tab's: this one is text on its own tint.
    assign k_accent_dark = kourify_color | color_darken: 25
    assign k_accent_light = kourify_color | color_lighten: 42
    assign k_accent_soft = kourify_color | color_lighten: 46

    assign kourify_palette_ok = true
    if k_rgb == blank or k_r == blank or k_g == blank or k_b == blank
      assign kourify_palette_ok = false
    endif
    if k_dark == blank or k_tint == blank or k_tint_strong == blank or k_wash == blank
      assign kourify_palette_ok = false
    endif
    if k_tab_start == blank or k_tab_end == blank or k_tab_icon == blank
      assign kourify_palette_ok = false
    endif
    if k_accent_dark == blank or k_accent_light == blank or k_accent_soft == blank
      assign kourify_palette_ok = false
    endif
  -%}
{%- if kourify_palette_ok -%}
  {%- comment -%}
    On `body`, not :root. kourify-protection.css is linked after the block
    that renders this, and two :root blocks of equal specificity are settled
    by document order -- the stylesheet would win and the merchant's colour
    would silently do nothing. Body is a different element and the tab and
    the modal are both its descendants.
  {%- endcomment -%}
  <style>
    body {
      --kourify-brand: {{ k_rgb }};
      --kourify-brand-dark: {{ k_dark }};
      --kourify-modal-brand: {{ k_dark }};
      --kourify-brand-rgb: {{ k_r }}, {{ k_g }}, {{ k_b }};
      --kourify-brand-veil-rgb: {{ k_r }}, {{ k_g }}, {{ k_b }};
      --kourify-brand-tint: {{ k_tint }};
      --kourify-brand-tint-strong: {{ k_tint_strong }};
      --kourify-brand-wash: {{ k_wash }};
      --kourify-tab-start: {{ k_tab_start }};
      --kourify-tab-end: {{ k_tab_end }};
      --kourify-tab-icon: {{ k_tab_icon }};
      --kourify-accent: {{ k_rgb }};
      --kourify-accent-dark: {{ k_accent_dark }};
      --kourify-accent-light: {{ k_accent_light }};
      --kourify-accent-soft: {{ k_accent_soft }};
    }
  </style>
{%- endif -%}
<span
  hidden
  data-kourify-i18n
  data-locale="{{ request.locale.iso_code | escape }}"
  {%- comment -%}
    Also read by the tab the script injects when the merchant has not added
    the block, so both routes to the tab say the same thing.
  {%- endcomment -%}
  data-guarantee="{{ kourify_guarantee | escape }}"
  {%- comment -%}
    Separate from data-logo-url, which every block carries and which the
    modal and the badges also read. This one is the merchant's own mark and
    only the tab uses it, so the two do not have to agree.
  {%- endcomment -%}
  data-brand-logo="{{ kourify_brand_logo | escape }}"
  data-brand-name="{{ kourify_brand_name | escape }}"
  data-modal-title="{{ kourify_modal_title | escape }}"
  data-managed="{{ kourify_managed | escape }}"
  data-learn-more="{{ 'protection.learn_more' | t | escape }}"
  data-file-claim="{{ 'protection.file_claim' | t | escape }}"
  data-included="{{ 'protection.included' | t | escape }}"
  data-included-heading="{{ 'protection.included_heading' | t | escape }}"
  data-modal-description="{{ 'protection.modal_description' | t | escape }}"
  data-modal-terms="{{ kourify_terms | escape }}"
  data-update-error="{{ 'protection.update_error' | t | escape }}"
  data-coverage-up-to="{{ 'protection.coverage_up_to' | t | escape }}"
></span>
