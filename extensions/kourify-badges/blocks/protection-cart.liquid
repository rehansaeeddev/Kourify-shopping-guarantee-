{%- liquid
  # The merchant's name, mark and colour, read straight from the app-data
  # metafields the admin publishes.
  #
  # Inlined rather than shared, though snippets/protection-translations.liquid
  # reads the same three: a rendered snippet gets its own scope, so nothing it
  # assigns is visible here, and capturing the render instead put Shopify's
  # own "BEGIN app snippet" comment into the output. Keep the copies in step.
  assign kourify_brand = app.metafields.kourify.brand_name.value | default: '' | strip
  assign kourify_brand_logo = app.metafields.kourify.brand_logo.value | default: '' | strip
  assign kourify_brand_color = app.metafields.kourify.brand_color.value | default: '' | strip

  if kourify_brand == blank
    assign kourify_guarantee = 'protection.guarantee' | t
  else
    assign kourify_guarantee = 'protection.guarantee_branded' | t: name: kourify_brand
  endif

  if kourify_brand_logo == blank
    assign kourify_brand_logo = 'kourify-logo.png' | asset_url
  endif
-%}
<div
  class="kourify-protection kourify-protection--cart"
  data-kourify-protection
  data-basis-cents="{{ cart.total_price | default: 0 }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-logo-url="{{ 'kourify-logo.png' | asset_url }}"
  {%- comment -%}
    Emitted only when the merchant has set no colour of their own. An inline
    custom property wins on its own element whatever a stylesheet says about
    an ancestor, so leaving this here unconditionally is exactly what kept
    this card green beside a pink tab. When a brand colour exists the whole
    accent family comes from the snippet's rule on `body` -- built by
    Liquid's colour filters, not printed as the merchant typed it.
  {%- endcomment -%}
  {% if kourify_brand_color == blank %}style="--kourify-accent: {{ block.settings.accent_color }};"{% endif %}
>
  {% render 'protection-translations' %}
  <span class="kourify-protection__tag">
    <img src="{{ kourify_brand_logo | escape }}" width="12" height="12" alt="" style="display:block;object-fit:contain;" />
    {{ kourify_guarantee | escape }}
  </span>

  <div class="kourify-protection__card">
    <label class="kourify-protection__option">
      <input type="checkbox" data-kourify-opt-in />
      <span class="kourify-protection__icon">
        <img src="{{ kourify_brand_logo | escape }}" width="18" height="18" alt="" style="display:block;object-fit:contain;" />
      </span>
      <span class="kourify-protection__body">
        <span class="kourify-protection__heading">{{ block.settings.heading }}</span>
        <span class="kourify-protection__description">{{ block.settings.description }}</span>
        {% if block.settings.show_learn_more %}
          <button type="button" class="kourify-protection__link" data-kourify-learn-more>
            {{ 'protection.learn_more' | t }}
          </button>
        {% endif %}
      </span>
      {% if block.settings.show_price %}
        <span class="kourify-protection__price">
          {{ block.settings.preview_price_cents | money }}
        </span>
      {% endif %}
    </label>
  </div>

  {%- comment -%}
    Filled in by kourify-protection.js from the merchant's configured
    eligibility ceiling, and left empty when no ceiling is set. The value is
    never hardcoded in the theme — a stale block setting must not be able to
    state a coverage limit the backend doesn't enforce.
  {%- endcomment -%}
  <p class="kourify-protection__footnote" data-kourify-coverage-note hidden></p>
</div>

{{ 'kourify-protection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kourify-protection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Kourify Protect (Cart)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Protect your order"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Coverage for loss, damage, or theft during delivery."
    },
    {
      "type": "checkbox",
      "id": "show_learn_more",
      "label": "Show Learn more",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "number",
      "id": "preview_price_cents",
      "label": "Preview price in cents",
      "default": 299
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
