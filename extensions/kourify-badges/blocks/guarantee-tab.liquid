<div
  class="kourify-guarantee-tab kourify-guarantee-tab--right"
  data-kourify-guarantee-tab
  data-logo-url="{{ 'kourify-logo.png' | asset_url }}"
>
  {% render 'protection-translations' %}
  {%- liquid
    # The merchant's name and logo, read straight from the app-data
    # metafields the admin publishes. The colour and the modal's wording are
    # the translations snippet's business, not this block's.
    #
    # Deliberately not a shared snippet, though snippets/protection-
    # translations.liquid reads the same metafields: Shopify wraps every app
    # snippet's output in "BEGIN app snippet" comments, so capturing a render
    # put that comment into this tab's own text. Keep the two in step.
    #
    # Interpolated rather than concatenated -- English puts the name first,
    # French and Arabic second -- and a shop that has set nothing falls
    # through to the wording and the mark this tab has always used.
    assign kourify_brand = app.metafields.kourify.brand_name.value | default: '' | strip
    assign kourify_brand_logo = app.metafields.kourify.brand_logo.value | default: '' | strip

    if kourify_brand == blank
      assign kourify_guarantee = 'protection.guarantee' | t
    else
      assign kourify_guarantee = 'protection.guarantee_branded' | t: name: kourify_brand
    endif

    if kourify_brand_logo == blank
      assign kourify_brand_logo = 'kourify-logo.png' | asset_url
    endif
  -%}
  <button type="button" class="kourify-guarantee-tab__button" data-kourify-learn-more>
    {%- comment -%}
      alt is empty on purpose: the shop's name is spelled out in the very
      next element, and a reader hearing it twice is worse than not
      describing a mark that carries nothing the name does not.
    {%- endcomment -%}
    <img src="{{ kourify_brand_logo | escape }}" width="14" height="14" alt="" style="display:block;object-fit:contain;" />
    {%- comment -%} Escaped: this is the merchant's own text, on every page of their store. {%- endcomment -%}
    <span>{{ kourify_guarantee | escape }}</span>
  </button>
</div>

{{ 'kourify-protection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kourify-protection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Kourify Guarantee Tab",
  "target": "body",
  "settings": []
}
{% endschema %}
